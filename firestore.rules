rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "justunme0423@gmail.com" ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }

    // All core facility operational collections
    match /animals/{animalId} {
      allow read, write: if true;
    }

    match /enclosures/{enclosureId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /inventory/{itemId} {
      allow read, write: if true;
    }

    match /medical_records/{recordId} {
      allow read, write: if true;
    }

    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    match /breeding_records/{recordId} {
      allow read, write: if true;
    }

    match /breeding_assessments/{assessmentId} {
      allow read, write: if true;
    }

    match /transfers/{transferId} {
      allow read, write: if true;
    }

    match /staff_members/{staffId} {
      allow read, write: if true;
    }

    match /facility_reports/{reportId} {
      allow read, write: if true;
    }

    match /statutory_reports/{reportId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
